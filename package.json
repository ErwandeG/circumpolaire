{
  "name": "star-trail-planner",
  "version": "0.4.6",
  "description": "Préparation de photos circumpolaires en ville : calendrier lunaire et vue du ciel à hauteur d'homme.",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "author": "ErwandeG",
  "homepage": "https://github.com/ErwandeG/star-trail-planner",
  "build": {
    "appId": "io.github.erwandeg.circumpolaire",
    "productName": "Star Trail Planner",
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Star Trail Planner",
      "artifactName": "StarTrailPlanner-${version}-installation.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "maintainer": "ErwandeG <91877730+ErwandeG@users.noreply.github.com>",
      "synopsis": "Préparation de photos circumpolaires en ville",
      "artifactName": "StarTrailPlanner-${version}-linux-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "StarTrailPlanner-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "leaflet": "1.9.4",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
